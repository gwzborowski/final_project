# .env.example
# Copy this file to .env and fill in real values. .env is git-ignored so your
# key never gets committed; .env.example is committed as documentation of
# what variables the app expects.

# Yelp Fusion API key (OPTIONAL). Get one free at https://www.yelp.com/developers.
# Used in utils/data_sources.py to enrich Overpass results with real price
# level and rating. If left blank or as the placeholder value, the app
# automatically falls back to clearly-labeled sample price/rating data so
# the Compare page still works.
YELP_API_KEY=your_yelp_api_key_here

# Default search radius (miles) used the first time the Search page loads.
DEFAULT_RADIUS_MILES=5

# Dash dev server settings
DASH_DEBUG=true
PORT=8050
